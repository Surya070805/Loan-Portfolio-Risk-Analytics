		annotation SummarizationSetBy = Automatic

	/// Per-loan FICO score, midpoint of the low/high range.
	column 'FICO Score' = (vw_loans[fico_range_low] + vw_loans[fico_range_high]) / 2
		dataType: double
		formatString: 0
		displayFolder: Borrower Analysis
		lineageTag: 38ba2c4e-6ce7-4df0-a33b-10139eb42d66

	/// Hidden sort key for FICO Score Range.
	column 'FICO Score Range Sort' = SWITCH(TRUE(), [FICO Score]<680,1, [FICO Score]<700,2, [FICO Score]<720,3, [FICO Score]<740,4, [FICO Score]<760,5, [FICO Score]<780,6, 7)
		dataType: int64
		isHidden
		displayFolder: Borrower Analysis
		lineageTag: 8476c41e-a9c3-4bc1-91b4-d4f994a58f71

	/// FICO score bucketed into ranges. Adjusted to this dataset's actual range (660-850) rather than the full theoretical FICO scale (300-850), since no loans fall below 660.
	column 'FICO Score Range' = SWITCH(TRUE(), [FICO Score]<680,"<680", [FICO Score]<700,"680-699", [FICO Score]<720,"700-719", [FICO Score]<740,"720-739", [FICO Score]<760,"740-759", [FICO Score]<780,"760-779", "780+")
		dataType: string
		displayFolder: Borrower Analysis
		lineageTag: b9d6606d-c1c6-42c7-9d8e-1e49d5fe7a32
		sortByColumn: 'FICO Score Range Sort'

	/// Hidden sort key for DTI Range.
	column 'DTI Range Sort' = SWITCH(TRUE(), vw_loans[dti]<5,1, vw_loans[dti]<10,2, vw_loans[dti]<15,3, vw_loans[dti]<20,4, vw_loans[dti]<25,5, 6)
		dataType: int64
		isHidden
		displayFolder: Borrower Analysis
		lineageTag: 8b6a2b31-778f-458f-90ab-43bb17f60f0f

	/// Debt-to-income ratio bucketed into ranges.
	column 'DTI Range' = SWITCH(TRUE(), vw_loans[dti]<5,"0-5%", vw_loans[dti]<10,"5-10%", vw_loans[dti]<15,"10-15%", vw_loans[dti]<20,"15-20%", vw_loans[dti]<25,"20-25%", ">25%")
		dataType: string
		displayFolder: Borrower Analysis
		lineageTag: e45ce962-409d-425c-940f-22e7ec9ebf0f
		sortByColumn: 'DTI Range Sort'

	/// Hidden sort key for Income Range.
	column 'Income Range Sort' = SWITCH(TRUE(), vw_loans[annual_inc]<25000,1, vw_loans[annual_inc]<50000,2, vw_loans[annual_inc]<75000,3, vw_loans[annual_inc]<100000,4, 5)
		dataType: int64
		isHidden
		displayFolder: Borrower Analysis
		lineageTag: 8e9730f2-7f31-49a0-a0a8-d2a71d52107f

	/// Annual income bucketed into ranges.
	column 'Income Range' = SWITCH(TRUE(), vw_loans[annual_inc]<25000,"<25K", vw_loans[annual_inc]<50000,"25K-50K", vw_loans[annual_inc]<75000,"50K-75K", vw_loans[annual_inc]<100000,"75K-100K", "100K+")
		dataType: string
		displayFolder: Borrower Analysis
		lineageTag: 4d4e3205-8c87-410e-b485-814d20fd4535
		sortByColumn: 'Income Range Sort'

	/// Hidden sort key for Employment Length Group.
	column 'Employment Length Sort' = SWITCH(TRUE(), vw_loans[emp_length]="< 1 year",1, vw_loans[emp_length] IN {"1 year","2 years","3 years"},2, vw_loans[emp_length] IN {"4 years","5 years"},3, vw_loans[emp_length] IN {"6 years","7 years","8 years","9 years"},4, vw_loans[emp_length]="10+ years",5, 6)
		dataType: int64
		isHidden
		displayFolder: Borrower Analysis
		lineageTag: 984fc294-660e-4af2-8fe0-61d580654770

	/// Raw emp_length text grouped into 5 bands. ~69K rows have no reported emp_length and fall into Unknown.
	column 'Employment Length Group' = SWITCH(TRUE(), vw_loans[emp_length]="< 1 year","<1yr", vw_loans[emp_length] IN {"1 year","2 years","3 years"},"1-3 years", vw_loans[emp_length] IN {"4 years","5 years"},"3-5 years", vw_loans[emp_length] IN {"6 years","7 years","8 years","9 years"},"5-10 years", vw_loans[emp_length]="10+ years","10+ years", "Unknown")
		dataType: string
		displayFolder: Borrower Analysis
		lineageTag: 622f3e80-aa99-4bcf-9ca7-67c8f8aea010
		sortByColumn: 'Employment Length Sort'

	/// Hidden sort key for Loan Amount Range.
	column 'Loan Amount Sort' = SWITCH(TRUE(), vw_loans[loan_amnt]<5000,1, vw_loans[loan_amnt]<10000,2, vw_loans[loan_amnt]<20000,3, vw_loans[loan_amnt]<30000,4, 5)
		dataType: int64
		isHidden
		displayFolder: Borrower Analysis
		lineageTag: 1df43373-ee7f-4c33-b5fe-d30b51248b18

	/// Loan amount bucketed into ranges.
	column 'Loan Amount Range' = SWITCH(TRUE(), vw_loans[loan_amnt]<5000,"<5K", vw_loans[loan_amnt]<10000,"5K-10K", vw_loans[loan_amnt]<20000,"10K-20K", vw_loans[loan_amnt]<30000,"20K-30K", "30K+")
		dataType: string
		displayFolder: Borrower Analysis
		lineageTag: 8f59c61b-7b44-45cd-bad4-19a5f122a3ff
		sortByColumn: 'Loan Amount Sort'

	partition vw_loans = m
		mode: import
		source =
				let
				    Source = Sql.Database("Surya\SQLEXPRESS", "Finance"),
				    dbo_vw_loans = Source{[Schema="dbo",Item="vw_loans"]}[Data]
				in
				    dbo_vw_loans

	annotation PBI_ResultType = Table

