table vw_loans
	lineageTag: 7f6c777c-4918-417a-a517-d381ee7a743b

	/// Total number of loans issued (matches all active filters).
	measure 'Total Loans' = COUNTROWS(vw_loans)
		formatString: #,##0
		displayFolder: Executive Overview
		lineageTag: 2f942557-89c2-46f9-86d9-f68b09659b2c

	/// Total funded amount across all loans, displayed in billions.
	measure 'Total Funded Amount' = SUM(vw_loans[funded_amnt])
		formatString: $#,##0.00
		displayFolder: Executive Overview
		lineageTag: b6dfeb45-ddd7-49ad-a81e-e1ace2265fa0

	/// Average interest rate. int_rate is stored as a percentage value (e.g. 12.8 = 12.8%), so this uses a literal % suffix rather than percentage formatting.
	measure 'Average Interest Rate' = AVERAGE(vw_loans[int_rate])
		formatString: 0.0"%"
		displayFolder: Executive Overview
		lineageTag: 161d483d-43db-4745-b1e3-a7aa8f147f0f

	/// Average borrower annual income, displayed in thousands.
	measure 'Average Annual Income' = AVERAGE(vw_loans[annual_inc])
		formatString: $#,##0.00
		displayFolder: Executive Overview
		lineageTag: 59c3a627-dd87-4bd8-ace6-6e177496ca37

	/// Count of loans classified as Good outcome.
	measure 'Good Loan Count' = CALCULATE(COUNTROWS(vw_loans), vw_loans[loan_outcome] = "Good")
		formatString: #,##0
		displayFolder: Executive Overview
		lineageTag: 483e05b6-a638-43cf-9770-d8d9cae57d5d

	/// Count of loans classified as Bad outcome.
	measure 'Bad Loan Count' = CALCULATE(COUNTROWS(vw_loans), vw_loans[loan_outcome] = "Bad")
		formatString: #,##0
		displayFolder: Executive Overview
		lineageTag: fd606c17-ab41-4268-a7c2-47177455c691

	/// Share of loans that are Good, as a % of total loans.
	measure 'Good Loan %' = DIVIDE([Good Loan Count], [Total Loans], 0)
		formatString: 0.00%
		displayFolder: Executive Overview
		lineageTag: 5281eccf-f3b2-4d56-a86e-f9631203525a

	/// Share of loans that are Bad, as a % of total loans.
	measure 'Bad Loan %' = DIVIDE([Bad Loan Count], [Total Loans], 0)
		formatString: 0.00%
		displayFolder: Executive Overview
		lineageTag: 91d01d55-d156-4984-bf0e-77a6e3103636

	/// Share of loans that are Bad (defaulted/charged off/delinquent), i.e. the portfolio default rate.
	measure 'Default Rate %' = DIVIDE([Bad Loan Count], [Total Loans], 0)
		formatString: 0.00%
		displayFolder: Credit Risk Analysis
		lineageTag: 676043d4-f5d7-4ee7-9f74-31bfc86698cb

	/// Portfolio-wide default rate, ignoring Grade/Purpose/State filters. Used as the benchmark line for high-risk comparisons.
	measure 'Overall Default Rate %' = CALCULATE([Default Rate %], ALL(dim_grade), ALL(dim_purpose), ALL(dim_geography))
		formatString: 0.00%
		displayFolder: Credit Risk Analysis
		lineageTag: 62425896-8b33-4249-b353-cbfd444cfe82

	/// Total loans belonging to grades whose own default rate exceeds 25%. Dynamic: recalculates which grades qualify under current filters.
	measure 'High Risk Loans (Default Rate > 25%)' = SUMX(VALUES(dim_grade[grade]), IF([Default Rate %] > 0.25, [Total Loans], 0))
		formatString: #,##0
		displayFolder: Credit Risk Analysis
		lineageTag: 8007c882-c68d-4ef8-a7d9-2e052c43a118

	/// Flags whether the current row's category (grade, purpose, or state - whatever is on the visual) has a default rate above the overall portfolio default rate. Use as a visual-level filter (=1) on High Risk tables.
	measure 'High Risk Flag (vs Overall)' = IF([Default Rate %] > [Overall Default Rate %], 1, 0)
		formatString: 0
		displayFolder: Credit Risk Analysis
		lineageTag: e12a88d2-59b5-44d8-b81e-1a2dbc298b1a

	/// Average borrower FICO score (midpoint of low/high range).
	measure 'Average FICO Score' = AVERAGE(vw_loans[FICO Score])
		formatString: 0
		displayFolder: Borrower Analysis
		lineageTag: 12a3af8d-581a-45c4-9547-4762fbd9bf86

	/// Average debt-to-income ratio. dti is stored as a percentage value directly, so this uses a literal % suffix. Note: a small number of rows (~1,300) have DTI outliers up to 999, likely data-entry placeholders for missing values.
	measure 'Average DTI' = AVERAGE(vw_loans[dti])
		formatString: 0.00"%"
		displayFolder: Borrower Analysis
		lineageTag: 59d8ef1d-e02c-48e8-89db-54d83dda91e6

	/// Distinct count of states with at least one loan under current filters.
	measure 'States Represented' = DISTINCTCOUNT(vw_loans[addr_state])
		formatString: 0
		displayFolder: Geographic Analysis
		lineageTag: 01021a4c-9e5c-4edf-80e4-8f9ada410dff

	/// Name of the state with the most loans, among states currently visible under filters.
	measure 'Top State by Loans' = VAR t = TOPN(1, VALUES(dim_geography[addr_state]), [Total Loans], DESC) RETURN CONCATENATEX(t, dim_geography[addr_state])
		displayFolder: Geographic Analysis
		lineageTag: 4ffba613-e15e-4c8d-8f9d-60d37f9c1230

	/// Loan count for the top state by volume.
	measure 'Top State Loan Count' = MAXX(VALUES(dim_geography[addr_state]), [Total Loans])
		formatString: #,##0
		displayFolder: Geographic Analysis
		lineageTag: 30f7e127-e659-4015-9bb1-f15a4d1d7d85

	/// State with the highest default rate, restricted to states with at least 500 loans to avoid small-sample noise skewing the ranking.
	measure 'Highest Default Rate State' = VAR t = TOPN(1, FILTER(VALUES(dim_geography[addr_state]), CALCULATE([Total Loans]) >= 500), [Default Rate %], DESC) RETURN CONCATENATEX(t, dim_geography[addr_state])
		displayFolder: Geographic Analysis
		lineageTag: 27a67b79-eab9-4b82-99e5-d9191e3bb368

	/// Default rate value for the highest-risk qualifying state (min. 500 loans).
	measure 'Highest Default Rate Value' = MAXX(FILTER(VALUES(dim_geography[addr_state]), [Total Loans] >= 500), [Default Rate %])
		formatString: 0.00%
		displayFolder: Geographic Analysis
		lineageTag: 5dadd6d7-1a7c-48dd-8d9a-bb6b0029bcb7

	/// Each state's share of total funded amount, ignoring the state filter for the denominator.
	measure '% of Total Funded Amount' = DIVIDE([Total Funded Amount], CALCULATE([Total Funded Amount], ALL(dim_geography)), 0)
		formatString: 0.00%
		displayFolder: Geographic Analysis
		lineageTag: a5e4d9de-9048-4e34-a6df-90f0f5492d87

	/// Share of loans across risk segment / geographic buckets.
	measure 'Share of Loans %' = DIVIDE([Total Loans], CALCULATE([Total Loans], ALL(dim_geography)), 0)
		formatString: 0.0%
		displayFolder: Geographic Analysis
		lineageTag: b5e4d9de-9048-4e34-a6df-90f0f5492d88

	/// Distinct count of states in current selection.
	measure 'State Count' = DISTINCTCOUNT(dim_geography[addr_state])
		formatString: #,##0
		displayFolder: Geographic Analysis
		lineageTag: c5e4d9de-9048-4e34-a6df-90f0f5492d89

